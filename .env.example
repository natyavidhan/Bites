# Copy this file to .env for local development.
# On Vercel, set these as Project Environment Variables instead.

# Admin login for /dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Long, random string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-too

# MongoDB connection (Atlas connection string, or a local mongodb:// URI)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=bites

# Optional: max upload size in bytes for a single site file (default 2MB)
MAX_UPLOAD_BYTES=2097152
